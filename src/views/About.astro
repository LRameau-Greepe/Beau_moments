---
// Over ons : l'histoire de Bert & Aude, leurs rôles, leurs valeurs.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import { site, abs } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.about;
const ld = [{
  '@type': 'AboutPage',
  url: abs(pagePath('about', lang)),
  about: { '@id': `${site.siteUrl}/#business` },
  mainEntity: [
    { '@type': 'Person', name: 'Bert', jobTitle: 'Chef', worksFor: { '@id': `${site.siteUrl}/#business` } },
    { '@type': 'Person', name: 'Aude', worksFor: { '@id': `${site.siteUrl}/#business` } },
  ],
}];
---
<Base lang={lang} title={s.meta.aboutTitle} description={s.meta.aboutDesc} alternates={allLangs((l) => pagePath('about', l))}
  section="about" breadcrumbs={[{ name: s.nav.about, path: pagePath('about', lang) }]} extraLd={ld} ogPhoto="bert-and-aude">
  <section class="hero">
    <div class="wrap g12">
      <div class="hero-text">
        <p class="label rise" style="--d:.05s">{a.label}</p>
        <h1 style="font-size:clamp(2.8rem,1.4rem + 4.2vw,6rem);line-height:1">{a.title}</h1>
        <p class="lead rise" style="--d:.45s">{a.lead}</p>
      </div>
      <div class="hero-media"><Photo name="bert-and-aude" lang={lang} eager maxh="calc(100svh - var(--header-h) - 8rem)" sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section quote bg-2"><div class="wrap">
    <Logo />
    <blockquote>{s.home.statement}</blockquote>
    <cite data-reveal>“{site.motto}”</cite>
  </div></section>

  <section class="wrap section g12 split">
    <div class="split-media" style="--col:1 / span 5"><Photo name="apron-details" lang={lang} maxh="85svh" sizes="(min-width: 900px) 36vw, 100vw" /></div>
    <div class="split-text" style="--col:7 / span 6">
      <p class="label" data-reveal>{a.label}</p>
      {a.story.map((p, i) => <p class={i === 0 ? 'lead' : ''} data-reveal style={i === 0 ? 'font-family:var(--serif);font-size:clamp(1.5rem,1.15rem + 1.2vw,2.2rem);line-height:1.3;color:var(--ink);max-width:none' : ''}>{p}</p>)}
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap duo">
      <div data-reveal>
        <Photo name="bert-serving" lang={lang} sizes="(min-width: 760px) 45vw, 100vw" />
        <h3>{a.bertTitle}</h3>
        <p>{a.bert}</p>
      </div>
      <div data-reveal style="--d:.1s">
        <div style="display:grid;gap:calc(var(--gap) / 2);margin-bottom:1.75rem">
          <Photo name="aude-at-work" lang={lang} sizes="(min-width: 760px) 45vw, 100vw" class="no-mb" />
          <Photo name="aude-with-guests" lang={lang} sizes="(min-width: 760px) 45vw, 100vw" class="no-mb" />
        </div>
        <h3>{a.audeTitle}</h3>
        <p>{a.aude}</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="label" data-reveal>{a.valuesLabel}</p><h2>BEAU MOMENTS</h2></div></div>
    <ol class="pillars">
      {a.values.map((v, i) => (
        <li data-reveal style={`--d:${i * 0.1}s`}><span class="p-n">{String(i + 1).padStart(2, '0')}</span><h3>{v.title}</h3><p>{v.text}</p></li>
      ))}
    </ol>
  </section>
</Base>
