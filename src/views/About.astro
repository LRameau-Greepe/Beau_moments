---
// Over ons : l'histoire de Bert & Aude, leurs rôles, leurs valeurs.
import Base from '../layouts/Base.astro';
import { site, abs } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.about;
const ld = [{
  '@type': 'AboutPage',
  url: abs(pagePath('about', lang)),
  about: { '@id': `${site.siteUrl}/#business` },
  mainEntity: [
    { '@type': 'Person', name: 'Bert', jobTitle: 'Chef', worksFor: { '@id': `${site.siteUrl}/#business` } },
    { '@type': 'Person', name: 'Aude', worksFor: { '@id': `${site.siteUrl}/#business` } },
  ],
}];
---
<Base lang={lang} title={s.meta.aboutTitle} description={s.meta.aboutDesc} alternates={allLangs((l) => pagePath('about', l))}
  section="about" breadcrumbs={[{ name: s.nav.about, path: pagePath('about', lang) }]} extraLd={ld} ogPhoto="bert-and-aude">
  <PageHero lang={lang} title="Bert & Aude" sub={a.lead} pos="50% 45%" photos={['chef-plating', 'bert-and-aude', 'serving-bubbles']} />
  <section class="pad wrap"><p class="say">{s.home.statement}</p></section>
  <section class="pad stone"><div class="wrap who">
    <Photo name="bert-serving" lang={lang} ratio="4/5" sizes="(min-width: 800px) 45vw, 90vw" /><div><h2>{a.bertTitle}</h2><p>{a.values[0].text}</p></div>
  </div></section>
  <section class="pad"><div class="wrap who flip">
    <Photo name="aude-with-guests" lang={lang} sizes="(min-width: 800px) 45vw, 90vw" /><div><h2>{a.audeTitle}</h2><p>{a.values[1].text}</p></div>
  </div></section>
</Base>
