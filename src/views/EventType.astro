---
// Page d'une formule de catering (privé chef aan huis, feesten, huwelijk, bedrijfsevents).
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { eventTypes, getEventType } from '../lib/events';
import { dishes } from '../lib/dishes';
import { site, abs } from '../lib/site';
import { pagePath, eventPath, allLangs, type EventKey } from '../i18n/routes';
import { localeInfo, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
interface Props { lang: Lang; eventKey: EventKey }
const { lang, eventKey } = Astro.props;
const s = t(lang);
const ev = getEventType(eventKey);
const c = ev.copy[lang];
const preset = eventTypes.findIndex((x) => x.key === eventKey);
const faq = [...c.faq, ...s.catering.faq.slice(0, 3)];
// Trois gerechten carrés, différents selon la formule
const offset = preset % 2 === 0 ? 0 : 1;
const shown = dishes.slice(offset, offset + 3);
const ld = [
  {
    '@type': 'Service',
    name: `BEAU MOMENTS — ${c.name}`,
    serviceType: c.name,
    description: c.metaDesc,
    url: abs(eventPath(eventKey, lang)),
    inLanguage: localeInfo[lang].html,
    provider: { '@id': `${site.siteUrl}/#business` },
    isRelatedTo: { '@id': `${site.siteUrl}/#catering` },
    areaServed: ['Maldegem', 'Brugge', 'Gent'].map((name) => ({ '@type': 'Place', name })),
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base lang={lang} title={c.metaTitle} description={c.metaDesc} alternates={allLangs((l) => eventPath(eventKey, l))} section="catering" extraLd={ld} hideCta
  ogPhoto={ev.hero} breadcrumbs={[{ name: s.nav.catering, path: pagePath('catering', lang) }, { name: c.name, path: eventPath(eventKey, lang) }]}>
  <section class="hero">
    <div class="wrap g12">
      <div class="hero-text">
        <ol class="crumbs rise" style="--d:.05s">
          <li><a href={pagePath('home', lang)}>{s.nav.home}</a></li>
          <li><a href={pagePath('catering', lang)}>{s.nav.catering}</a></li>
        </ol>
        <p class="label rise" style="--d:.1s">{c.name}</p>
        <h1 style="font-size:clamp(3rem,1.5rem + 4.6vw,6.5rem);line-height:.98">{c.title}</h1>
        <p class="lead rise" style="--d:.45s">{c.lead}</p>
        <p class="actions rise" style="--d:.6s"><a class="btn btn-solid" href="#aanvraag">{s.catering.cta}</a></p>
      </div>
      <div class="hero-media"><Photo name={ev.hero} lang={lang} eager maxh="calc(100svh - var(--header-h) - 8rem)" sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap g12 split">
      <div class="split-media" style="--col:1 / span 5"><Photo name={ev.body} lang={lang} maxh="85svh" sizes="(min-width: 900px) 36vw, 100vw" /></div>
      <div class="split-text" style="--col:7 / span 6">
        {c.body.map((p, i) => <p class={i === 0 ? 'lead' : ''} data-reveal style={i === 0 ? 'font-family:var(--serif);font-size:clamp(1.6rem,1.2rem + 1.4vw,2.4rem);line-height:1.3;color:var(--ink);max-width:none' : ''}>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="label" data-reveal>{c.name}</p><h2>{s.catering.ideasTitle}</h2></div></div>
    <ul class="ideas">{c.ideas.map((it, i) => <li data-reveal style={`--d:${i * 0.1}s`}><h3>{it.title}</h3><p>{it.text}</p></li>)}</ul>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="section-head">
      <div><p class="label" data-reveal>Chef Bert</p><h2>{s.home.dishesTitle}</h2></div>
      <a class="link" href={pagePath('gallery', lang)} data-reveal>{s.home.galleryAll}</a>
    </div>
    <div class="trio">
      {shown.map((d, i) => (
        <div class="dish" data-reveal style={`--d:${i * 0.1}s`}>
          <Photo name={d.photo} lang={lang} sizes="(min-width: 760px) 32vw, 50vw" />
          <h3>{d.name[lang]}</h3>
          <p>{d.notes[lang]}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section g12 faq-grid" style="padding-top:0">
    <div><p class="label" data-reveal>{s.common.faq}</p><h2 data-split>{c.name}</h2></div>
    <Faq items={faq} />
  </section>

  <section class="section bg-sand" id="aanvraag">
    <div class="wrap g12 form-grid">
      <div>
        <p class="label" data-reveal>{s.catering.formLabel}</p>
        <h2 data-split>{s.catering.formTitle}</h2>
        <p class="lead" data-reveal>{s.catering.formText}</p>
      </div>
      <EnquiryForm lang={lang} preset={preset} />
    </div>
  </section>
</Base>
