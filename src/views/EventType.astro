---
// Page d'une formule de catering (privé chef aan huis, feesten, huwelijk, bedrijfsevents).
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { eventTypes, getEventType } from '../lib/events';
import { dishes } from '../lib/dishes';
import { site, abs } from '../lib/site';
import { pagePath, eventPath, allLangs, type EventKey } from '../i18n/routes';
import { localeInfo, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import Enquiry from '../components/Enquiry.astro';
import type { PhotoKey } from '../lib/photos';
interface Props { lang: Lang; eventKey: EventKey }
const { lang, eventKey } = Astro.props;
const s = t(lang);
const ev = getEventType(eventKey);
const c = ev.copy[lang];
const preset = eventTypes.findIndex((x) => x.key === eventKey);
const faq = [...c.faq, ...s.catering.faq.slice(0, 3)];
const shown = dishes.filter((d) => d.photo !== 'croquettes');
// Photos propres à chaque formule
const looks: Record<EventKey, { photos: PhotoKey[]; ideas: PhotoKey[] }> = {
  home: { photos: ['lobster-sauce', 'bert-serving', 'caviar-dish'], ideas: ['table-lemons', 'side-dish', 'oysters'] },
  celebrations: { photos: ['table-long', 'ready-to-serve', 'egg-shrimp-garden'], ideas: ['flowers', 'appetizers', 'dinner-served'] },
  weddings: { photos: ['table-candles', 'champagne-bar', 'valentine-table'], ideas: ['serving-bubbles', 'valentine-barn', 'table-flowers'] },
  corporate: { photos: ['atelier-dinner-from-above', 'bites-tray', 'olive-oil-tasting'], ideas: ['waiter-tray', 'private-dining-bowls', 'awa-shiso-ice'] },
};
const look = looks[eventKey];
const ld = [
  {
    '@type': 'Service',
    name: `BEAU MOMENTS — ${c.name}`,
    serviceType: c.name,
    description: c.metaDesc,
    url: abs(eventPath(eventKey, lang)),
    inLanguage: localeInfo[lang].html,
    provider: { '@id': `${site.siteUrl}/#business` },
    isRelatedTo: { '@id': `${site.siteUrl}/#catering` },
    areaServed: ['Maldegem', 'Brugge', 'Gent'].map((name) => ({ '@type': 'Place', name })),
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base lang={lang} title={c.metaTitle} description={c.metaDesc} alternates={allLangs((l) => eventPath(eventKey, l))} section="catering" extraLd={ld} hideCta
  ogPhoto={ev.hero} breadcrumbs={[{ name: s.nav.catering, path: pagePath('catering', lang) }, { name: c.name, path: eventPath(eventKey, lang) }]}>
  <PageHero lang={lang} title={c.name} sub={c.title} photos={look.photos}>
    <a class="btn" href="#aanvraag">{s.catering.cta}</a>
  </PageHero>
  <section class="pad wrap">
    <h2 class="sr">{s.catering.ideasTitle}</h2>
    <ul class="incl" role="list">{c.ideas.map((it, i) => <li><Photo name={look.ideas[i]} lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 90vw" /><h3>{it.title}</h3></li>)}</ul>
  </section>
  <section class="pad sand">
    <h2 class="mid">{s.home.dishesTitle}</h2>
    <ul class="plates" role="list" tabindex="0" aria-label={s.home.dishesTitle}>
      {shown.map((d) => <li><Photo name={d.photo} lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 70vw" /><h3>{d.name[lang]}</h3><p>{d.notes[lang]}</p></li>)}
    </ul>
  </section>
  <section class="pad wrap duo"><h2>{s.catering.faqTitle}</h2><Faq items={faq} /></section>
  <Enquiry lang={lang} preset={preset} />
</Base>
