---
// Catering : les formules (privé chef aan huis, feesten, huwelijk, bedrijfsevents), ce qui est inclus,
// la méthode, la FAQ et le formulaire de demande.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { eventTypes } from '../lib/events';
import { site, abs } from '../lib/site';
import { pagePath, eventPath, allLangs } from '../i18n/routes';
import { localeInfo, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import Formulas from '../components/Formulas.astro';
import Enquiry from '../components/Enquiry.astro';
import type { PhotoKey } from '../lib/photos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const c = s.catering;
const ld = [
  {
    '@type': 'Service',
    '@id': `${site.siteUrl}/#catering`,
    name: `BEAU MOMENTS — ${c.label}`,
    serviceType: c.label,
    description: s.meta.cateringDesc,
    url: abs(pagePath('catering', lang)),
    inLanguage: localeInfo[lang].html,
    provider: { '@id': `${site.siteUrl}/#business` },
    areaServed: ['Maldegem', 'Brugge', 'Gent'].map((name) => ({ '@type': 'Place', name })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: c.label,
      itemListElement: eventTypes.map((x) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: x.copy[lang].name, description: x.copy[lang].short, url: abs(eventPath(x.key, lang)) } })),
    },
  },
  { '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const inclPhotos: PhotoKey[] = ['hamachi', 'european-lobster', 'dinner-served', 'table-flowers', 'flowers', 'olive-oil-tasting'];
---
<Base lang={lang} title={s.meta.cateringTitle} description={s.meta.cateringDesc} alternates={allLangs((l) => pagePath('catering', l))}
  section="catering" breadcrumbs={[{ name: s.nav.catering, path: pagePath('catering', lang) }]} extraLd={ld} ogPhoto="table-long" hideCta>
  <PageHero lang={lang} title={s.nav.catering} sub={c.title} photos={['dinner-served']}>
    <a class="btn" href="#aanvraag">{c.cta}</a>
  </PageHero>
  <section class="pad"><div class="wrap"><h2 class="mid">{c.typesTitle}</h2><Formulas lang={lang} /></div></section>
  <section class="pad stone">
    <div class="wrap">
      <h2 class="mid">{c.includedTitle}</h2>
      <ul class="incl" role="list">{c.included.map((it, i) => <li><Photo name={inclPhotos[i]} lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 46vw" /><h3>{it.title}</h3></li>)}</ul>
    </div>
  </section>
  <section class="pad sand">
    <div class="wrap"><h2>{c.processTitle}</h2>
      <ol class="steps" role="list">{c.process.map((p, i) => <li><span class="num">{i + 1}</span><h3>{p.title}</h3></li>)}</ol>
    </div>
  </section>
  <section class="pad wrap duo"><h2>{c.faqTitle}</h2><Faq items={c.faq} /></section>
  <Enquiry lang={lang} />
</Base>
