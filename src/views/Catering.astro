---
// Catering : les formules (privé chef aan huis, feesten, huwelijk, bedrijfsevents), ce qui est inclus,
// la méthode, la FAQ et le formulaire de demande.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { eventTypes } from '../lib/events';
import { site, abs, tel, mailHref } from '../lib/site';
import { pagePath, eventPath, allLangs } from '../i18n/routes';
import { localeInfo, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const c = s.catering;
const ld = [
  {
    '@type': 'Service',
    '@id': `${site.siteUrl}/#catering`,
    name: `BEAU MOMENTS — ${c.label}`,
    serviceType: c.label,
    description: s.meta.cateringDesc,
    url: abs(pagePath('catering', lang)),
    inLanguage: localeInfo[lang].html,
    provider: { '@id': `${site.siteUrl}/#business` },
    areaServed: ['Maldegem', 'Brugge', 'Gent'].map((name) => ({ '@type': 'Place', name })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: c.label,
      itemListElement: eventTypes.map((x) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: x.copy[lang].name, description: x.copy[lang].short, url: abs(eventPath(x.key, lang)) } })),
    },
  },
  { '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base lang={lang} title={s.meta.cateringTitle} description={s.meta.cateringDesc} alternates={allLangs((l) => pagePath('catering', l))}
  section="catering" breadcrumbs={[{ name: s.nav.catering, path: pagePath('catering', lang) }]} extraLd={ld} ogPhoto="table-long" hideCta>
  <section class="hero">
    <div class="wrap g12">
      <div class="hero-text">
        <p class="label rise" style="--d:.05s">{c.label}</p>
        <h1 style="font-size:clamp(3rem,1.5rem + 5vw,7rem);line-height:.98">{c.title}</h1>
        <p class="lead rise" style="--d:.45s">{c.lead}</p>
        <p class="actions rise" style="--d:.6s"><a class="btn btn-solid" href="#aanvraag">{c.cta}</a></p>
      </div>
      <div class="hero-media"><Photo name="plating-sauce" lang={lang} eager maxh="calc(100svh - var(--header-h) - 8rem)" sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head">
        <div><p class="label" data-reveal><span class="n">01</span> {c.typesLabel}</p><h2>{c.typesTitle}</h2></div>
        <p class="lead" data-reveal>{s.home.cateringText}</p>
      </div>
      <div class="grid-4">
        {eventTypes.map((e, i) => (
          <a class="type-card" href={eventPath(e.key, lang)} data-reveal style={`--d:${i * 0.08}s`}>
            <Photo name={e.hero} lang={lang} sizes="(min-width: 1320px) 310px, (min-width: 960px) 23vw, 50vw" />
            <h3>{e.copy[lang].name}</h3>
            <p>{e.copy[lang].short}</p>
            <span class="link">{s.common.moreInfo}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div><p class="label" data-reveal><span class="n">02</span> {c.includedLabel}</p><h2>{c.includedTitle}</h2></div>
    </div>
    <ul class="included">
      {c.included.map((it, i) => <li data-reveal style={`--d:${(i % 3) * 0.1}s`}><h3>{it.title}</h3><p>{it.text}</p></li>)}
    </ul>
  </section>

  <section class="section bg-sand">
    <div class="wrap">
      <div class="trio" data-reveal style="margin-bottom:clamp(4rem,7vw,6rem)">
        <Photo name="table-lemons" lang={lang} sizes="(min-width: 760px) 32vw, 50vw" />
        <Photo name="flower-bites" lang={lang} sizes="(min-width: 760px) 32vw, 50vw" />
        <Photo name="table-flowers" lang={lang} sizes="(min-width: 760px) 32vw, 50vw" />
      </div>
      <div class="section-head">
        <div><p class="label" data-reveal><span class="n">03</span> {c.processLabel}</p><h2>{c.processTitle}</h2></div>
      </div>
      <ol class="steps">
        {c.process.map((p, i) => <li data-reveal style={`--d:${i * 0.1}s`}><h3>{p.title}</h3><p>{p.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="wrap section">
    <ul class="type-list" style="margin-top:0">
      {eventTypes.map((ty, i) => (
        <li data-reveal style={`--d:${i * 0.08}s`}>
          <a class="type-row" href={eventPath(ty.key, lang)}>
            <span class="tr-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{ty.copy[lang].name}</h3>
            <p>{ty.copy[lang].short}</p>
            <span class="tr-arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section g12 faq-grid" style="padding-top:0">
    <div><p class="label" data-reveal><span class="n">04</span> {s.common.faq}</p><h2 data-split>{c.faqTitle}</h2></div>
    <Faq items={c.faq} />
  </section>

  <section class="section bg-sand" id="aanvraag">
    <div class="wrap g12 form-grid">
      <div>
        <p class="label" data-reveal><span class="n">05</span> {c.formLabel}</p>
        <h2 data-split>{c.formTitle}</h2>
        <p class="lead" data-reveal>{c.formText}</p>
        <div class="contact-lines" data-reveal>
          {site.contacts.map((x) => <span>{x.name} · <a href={tel(x.phone)}>{x.phone}</a></span>)}
          <a href={mailHref}>{site.email}</a>
          <a href={site.social.instagram.url} target="_blank" rel="noopener">@{site.social.instagram.handle}</a>
        </div>
      </div>
      <EnquiryForm lang={lang} />
    </div>
  </section>
</Base>
