---
// Atelier : private dining à Maldegem (8 à 18 personnes), adresse, contact, FAQ.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.atelier;
const ld = [{ '@type': 'FAQPage', mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base lang={lang} title={s.meta.atelierTitle} description={s.meta.atelierDesc} alternates={allLangs((l) => pagePath('atelier', l))}
  section="atelier" breadcrumbs={[{ name: s.nav.atelier, path: pagePath('atelier', lang) }]} extraLd={ld} ogPhoto="atelier-dinner-from-above">
  <section class="page-head">
    <div class="wrap g12">
      <div class="page-head-title">
        <p class="label rise" style="--d:.05s">{a.label}</p>
        <h1>{a.title}</h1>
      </div>
      <div class="page-head-lead"><p class="lead rise" style="--d:.4s">{a.lead}</p></div>
    </div>
  </section>

  <section class="wrap g12 split" style="padding-bottom:clamp(5.5rem,3rem + 9vw,11rem)">
    <div class="split-media"><Photo name="atelier-facade" lang={lang} eager maxh="85svh" sizes="(min-width: 900px) 46vw, 100vw" /></div>
    <div class="split-text">
      <p class="label" data-reveal>{a.detailsLabel}</p>
      <ContactBlock lang={lang} guests />
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap g12 split reverse">
      <div class="split-media pair">
        <Photo name="atelier-from-above" lang={lang} sizes="(min-width: 900px) 24vw, 50vw" />
        <Photo name="atelier-dinner-from-above" lang={lang} sizes="(min-width: 900px) 24vw, 50vw" />
      </div>
      <div class="split-text">
        <p class="label" data-reveal>Private dining</p>
        <h2 data-split>{a.introTitle}</h2>
        {a.intro.map((p) => <p data-reveal>{p}</p>)}
        <p data-reveal style="margin-top:2rem"><a class="btn btn-solid" href={`${pagePath('catering', lang)}#aanvraag`}>{s.catering.cta}</a></p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="interiors" data-reveal>
      <Photo name="chef-plating" lang={lang} sizes="(min-width: 1320px) 420px, (min-width: 760px) 32vw, 50vw" />
      <Photo name="apron-details" lang={lang} sizes="(min-width: 1320px) 420px, (min-width: 760px) 32vw, 50vw" />
      <Photo name="ready-to-serve" lang={lang} sizes="(min-width: 1320px) 420px, (min-width: 760px) 32vw, 50vw" />
    </div>
  </section>

  <section class="wrap section g12 faq-grid" style="padding-top:0">
    <div><p class="label" data-reveal>{s.common.faq}</p><h2 data-split>{s.nav.atelier}</h2></div>
    <Faq items={a.faq} />
  </section>
</Base>
