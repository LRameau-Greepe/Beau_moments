---
// Accueil : deux actions, la maison, la catering (une section par formule), l'atelier, les plats, les offres, la galerie, les avis, le contact.
import Base from '../layouts/Base.astro';
import { feest } from '../lib/feestdagen';
import { dishes } from '../lib/dishes';
import { reviews, googleRating, googleReviewsUrl } from '../lib/reviews';
import { type PhotoKey } from '../lib/photos';
import { site, tel, mailHref } from '../lib/site';
import { pagePath, eventPath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import { L as Lx, localeInfo, type Lang } from '../i18n/locales';
import Photo from '../components/Photo.astro';
import { eventTypes } from '../lib/events';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const f = feest[lang];
const h = s.home;
const L = Lx(lang);
const gallery: PhotoKey[] = ['valentine-table', 'hamachi', 'table-room', 'bert-serving'];
const plates = dishes.filter((d) => d.photo !== 'croquettes');
---
<Base lang={lang} title={s.meta.homeTitle} description={s.meta.homeDesc} alternates={allLangs((l) => pagePath('home', l))} ogPhoto="table-room">
  <section class="hero">
    <Photo name="table-room" lang={lang} eager class="cover" sizes="100vw" />
    <div><h1>Beau Moments</h1><p>{h.heroLine1} {h.heroLine2}</p>
      <p class="acts"><a class="btn" href={`${pagePath('catering', lang)}#aanvraag`}>{h.ctaPrimary}</a><a class="btn" href={pagePath('takeaway', lang)}>{s.nav.takeaway}</a></p></div>
  </section>

  <section class="pad wrap intro"><p class="say">{h.statement}</p></section>

  <section class="half flip">
    <Photo name="bert-and-aude" lang={lang} sizes="(min-width: 800px) 50vw, 100vw" />
    <div><h2>{h.aboutTitle}</h2><a class="btn" href={pagePath('about', lang)}>{h.aboutMore}</a></div>
  </section>

  <section class="pad intro stone"><h2>{h.cateringTitle}</h2><a class="btn" href={pagePath('catering', lang)}>{h.ctaSecondary}</a></section>
  {eventTypes.map((e, i) => (
    <section class:list={['half', 'stone', { flip: i % 2 === 1 }]}>
      <Photo name={e.hero} lang={lang} sizes="(min-width: 800px) 50vw, 100vw" />
      <div><h3 class="big">{e.copy[lang].name}</h3><a class="btn" href={eventPath(e.key, lang)}>{s.common.moreInfo}</a></div>
    </section>
  ))}

  <section class="half sand">
    <Photo name="atelier-dinner-from-above" lang={lang} sizes="(min-width: 800px) 50vw, 100vw" />
    <div><h2>{h.atelierTitle}</h2><p>{s.atelier.guestsText}</p><a class="btn" href={pagePath('atelier', lang)}>{L('Ontdek het atelier', 'Découvrir l’atelier', 'Discover the atelier')}</a></div>
  </section>

  <section class="pad">
    <h2 class="mid">{h.dishesTitle}</h2>
    <ul class="plates" role="list" tabindex="0" aria-label={h.dishesTitle}>
      {plates.map((d) => <li><Photo name={d.photo} lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 70vw" /><h3>{d.name[lang]}</h3><p>{d.notes[lang]}</p></li>)}
    </ul>
  </section>

  <section class="pad" id="momenten"><div class="wrap">
    <h2 class="mid">{L('Nu bij Beau Moments', 'En ce moment', 'Now at Beau Moments')}</h2>
    <ul class="offers" role="list">
      <li><a href={`${pagePath('takeaway', lang)}#feestdagen`}><Photo name="feest-cover" lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 90vw" /><h3>{f.label}</h3></a><p>{f.deadline}</p><p class="small">{f.allergens}</p></li>
      <li><a href={pagePath('takeaway', lang)}><Photo name="egg-shrimp-garden" lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 90vw" /><h3>{h.takeawayTitle}</h3></a></li>
      <li><a href={pagePath('atelier', lang)}><Photo name="atelier-dining-room" lang={lang} ratio="4/5" sizes="(min-width: 800px) 30vw, 90vw" /><h3>{h.privateLabel}</h3></a><p>{s.atelier.guestsText}</p></li>
    </ul>
  </div></section>

  <section class="strip" style="padding-top:clamp(5rem,9vw,9rem)" aria-label={s.nav.gallery}>
    {gallery.map((k) => <Photo name={k} lang={lang} ratio="4/5" sizes="(min-width: 800px) 24vw, 46vw" />)}
    <a class="btn" href={pagePath('gallery', lang)}>{h.galleryAll}</a>
  </section>

  <section class="pad stone">
    <div class="wrap rev-head"><h2 class="sr">{h.reviewsTitle}</h2>
      <p class="num">{googleRating.score.toLocaleString(localeInfo[lang].html)}</p>
      <a href={googleReviewsUrl} target="_blank" rel="noopener">{h.googleCount.replace('{n}', String(googleRating.count))}</a></div>
    <ul class="revs" role="list" tabindex="0" aria-label={h.reviewsTitle}>
      {reviews.map((r) => <li><blockquote>{r.quote[lang]}</blockquote><cite><span role="img" aria-label={`${r.stars}/5`}>{'★'.repeat(r.stars)}</span>{r.author}</cite></li>)}
    </ul>
    {h.reviewsNote && <p class="wrap small">{h.reviewsNote}</p>}
  </section>

  <section class="half flip sand" id="contact">
    <Photo name="atelier-facade" lang={lang} sizes="(min-width: 800px) 50vw, 100vw" />
    <div><h2>Contact</h2>
      <p>{site.address.street}<br />{site.address.postalCode} {site.address.city}</p>
      <p>{site.contacts.map((x) => <><a href={tel(x.phone)}>{x.name} {x.phone}</a><br /></>)}<a href={mailHref}>{site.email}</a></p>
      <a class="btn" href={site.mapUrl} target="_blank" rel="noopener">{s.common.openMap}</a></div>
  </section>
</Base>
