---
// Galerie : les photos Instagram de BEAU MOMENTS regroupées par chapitres (les gerechten, le signature,
// l'atelier, les tables, la réception, les fêtes, les coulisses, les bulles, les moments). Chaque photo garde
// ses proportions ; chaque chapitre a une mise en page qui tombe juste (grille régulière ou rangée justifiée),
// sans rangée incomplète. Clic = visionneuse plein écran.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import { getImage } from 'astro:assets';
import { getPhoto, type PhotoKey } from '../lib/photos';
import { site, abs } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { localeInfo, L as Lx, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const ig = site.social.instagram;
const L = Lx(lang);

// Toutes les photos de la galerie ont la même hauteur (5 photos carrées par rangée) ; la largeur suit les proportions.
const chapters: { id: string; title: string; lead: string; photos: PhotoKey[]; more?: boolean }[] = [
  { id: 'gerechten', title: L('Op het bord', 'Dans l’assiette', 'On the plate'), lead: L('Kreeft, langoustine, hoeve-ei en dame blanche: klassiek Frans, met een moderne toets.', 'Homard, langoustine, œuf fermier et dame blanche : classique français, touche moderne.', 'Lobster, langoustine, farm egg and dame blanche: classic French, with a modern touch.'),
    photos: ['lobster-caviar', 'lobster-sauce', 'egg-shrimp-tray', 'langoustine'] },
  { id: 'voorgerecht-tot-dessert', title: L('Van voorgerecht tot dessert', 'De l’entrée au dessert', 'From starter to dessert'), lead: L('Sint-jakobsvrucht, ceviche, krokante hapjes en een dame blanche.', 'Saint-Jacques, ceviche, bouchées croustillantes et dame blanche.', 'Scallop, ceviche, crisp bites and a dame blanche.'),
    photos: ['scallop-dish', 'langoustine-ceviche', 'flower-bites', 'dame-blanche'] },
  { id: 'signatuur', title: L('Signatuur', 'Signature', 'Signature'), lead: L('Kaviaar, oesters, hamachi en Europese kreeft.', 'Caviar, huîtres, hamachi et homard européen.', 'Caviar, oysters, hamachi and European lobster.'),
    photos: ['caviar-dish', 'oysters', 'hamachi', 'european-lobster'] },
  { id: 'atelier', title: L('Het atelier', 'L’atelier', 'The atelier'), lead: L('Industrielaan 3/C1 in Maldegem: private dining voor 8 tot 18 personen.', 'Industrielaan 3/C1 à Maldegem : private dining pour 8 à 18 personnes.', 'Industrielaan 3/C1 in Maldegem: private dining for 8 to 18 guests.'),
    photos: ['atelier-facade', 'atelier-from-above', 'atelier-dinner-from-above', 'atelier-dining-room'] },
  { id: 'tafels', title: L('Gedekte tafels', 'Tables dressées', 'Laid tables'), lead: L('Een prachtig gedekte tafel maakt het plaatje compleet.', 'Une belle table dressée complète le tableau.', 'A beautifully laid table completes the picture.'),
    photos: ['table-lemons', 'table-room', 'table-flowers', 'table-candles'] },
  { id: 'receptie', title: L('Hapjes & receptie', 'Bouchées & réception', 'Canapés & receptions'), lead: L('Koud geserveerd, warm ontvangen: zo beginnen feesten.', 'Servi froid, accueilli chaleureusement : ainsi commencent les fêtes.', 'Served cold, welcomed warmly: that is how parties begin.'),
    photos: ['appetizers', 'tartelettes', 'egg-shrimp-garden', 'waiter-tray'] },
  { id: 'producten', title: L('Producten', 'Les produits', 'The produce'), lead: L('Coquilles Saint-Jacques, gemarmerd rundvlees, olijfolie: alleen het beste.', 'Saint-Jacques, bœuf persillé, huile d’olive : seulement le meilleur.', 'Scallops, marbled beef, olive oil: only the best.'),
    photos: ['scallops', 'beef-cuts', 'olive-oil-tasting', 'private-dining-bowls'] },
  { id: 'feesten', title: L('Feesten', 'Fêtes', 'Celebrations'), lead: L('Valentijn in een oude schuur, een tafel in de tuin, bubbels bij de receptie.', 'La Saint-Valentin dans une grange, une table au jardin, des bulles à la réception.', 'Valentine’s in an old barn, a table in the garden, bubbles at the reception.'),
    photos: ['valentine-barn', 'valentine-table', 'garden-table', 'champagne-bar'] },
  { id: 'details', title: L('Details', 'Détails', 'Details'), lead: L('Een bloem op het bord, een strik, een laatste toets aan de pass.', 'Une fleur dans l’assiette, un nœud papillon, une dernière touche au passe.', 'A flower on the plate, a bow tie, a final touch at the pass.'),
    photos: ['side-dish', 'strawberry-dessert', 'ready-to-serve', 'chef-plating'] },
  { id: 'achter-de-schermen', title: L('Achter de schermen', 'En coulisses', 'Behind the scenes'), lead: L('Achter het gordijn worden de mooiste momenten voorbereid.', 'Derrière le rideau se préparent les plus beaux moments.', 'Behind the curtain, the finest moments are prepared.'),
    photos: ['plating-sauce', 'apron-details', 'kitchen-beef', 'behind-the-curtain'] },
  { id: 'bubbels', title: L('Bubbels & details', 'Bulles & détails', 'Bubbles & details'), lead: L('Ook alcoholvrij: AWA Shiso, met Japanse signatuur.', 'Aussi sans alcool : AWA Shiso, d’inspiration japonaise.', 'Alcohol-free too: AWA Shiso, with a Japanese signature.'),
    photos: ['awa-shiso-ice', 'awa-shiso-bottle', 'apero', 'croquettes'] },
  { id: 'momenten', title: L('Momenten', 'Moments', 'Moments'), lead: L('Bert, Aude en hun gasten.', 'Bert, Aude et leurs invités.', 'Bert, Aude and their guests.'),
    photos: ['bert-and-aude', 'bert-serving', 'serving-bubbles'], more: true },
];

// Version grand format pour la visionneuse (jusqu'à la pleine résolution de l'original)
const all = chapters.flatMap((c) => c.photos);
const full = Object.fromEntries(await Promise.all(all.map(async (k) => {
  const src = getPhoto(k).src;
  const img = await getImage({ src, width: Math.min(1300, src.width), format: 'webp', quality: 80 });
  return [k, img.src];
})));
const ratio = (k: PhotoKey) => (getPhoto(k).src.width / getPhoto(k).src.height).toFixed(4);

const ld = [{
  '@type': 'ImageGallery',
  name: s.gallery.title,
  inLanguage: localeInfo[lang].html,
  url: abs(pagePath('gallery', lang)),
  author: { '@id': `${site.siteUrl}/#business` },
  image: all.map((k) => ({ '@type': 'ImageObject', contentUrl: abs(full[k]), caption: getPhoto(k).alt[lang] })),
}];
const ui = { close: L('Sluiten', 'Fermer', 'Close'), prev: L('Vorige foto', 'Photo précédente', 'Previous photo'), next: L('Volgende foto', 'Photo suivante', 'Next photo') };
---
<Base lang={lang} title={s.meta.galleryTitle} description={s.meta.galleryDesc} alternates={allLangs((l) => pagePath('gallery', l))}
  section="gallery" breadcrumbs={[{ name: s.nav.gallery, path: pagePath('gallery', lang) }]} extraLd={ld} ogPhoto="table-candles">
  <section class="page-head">
    <div class="wrap g12">
      <div class="page-head-title">
        <p class="label rise" style="--d:.05s">{s.gallery.label} · Instagram</p>
        <h1>{s.gallery.title}</h1>
      </div>
      <div class="page-head-lead"><p class="lead rise" style="--d:.4s">{s.gallery.lead}</p></div>
    </div>
    <nav class="wrap g-chapters rise" style="--d:.5s" aria-label={s.nav.gallery}>
      {chapters.map((c, i) => <a href={`#${c.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{c.title}</a>)}
    </nav>
  </section>

  {chapters.map((c, ci) => (
    <section class:list={['section-sm', { 'bg-2': ci % 2 === 1 }]} id={c.id}>
      <div class="wrap">
        <div class="section-head" style="margin-bottom:clamp(1.25rem,2.5vw,1.75rem)">
          <div><p class="label" data-reveal><span class="n">{String(ci + 1).padStart(2, '0')}</span> {s.nav.gallery}</p><h2>{c.title}</h2></div>
          <p class="lead" data-reveal>{c.lead}</p>
        </div>
        <div class="g-flow">
          {c.photos.map((k) => (
            <a class="g-item" href={full[k]} style={`--r:${ratio(k)}`} data-lightbox data-caption={getPhoto(k).alt[lang]} data-post={getPhoto(k).post} data-reveal>
              <Photo name={k} lang={lang} sizes={`(min-width: 860px) ${Math.ceil(20 * Number(ratio(k)))}vw, ${Math.ceil(50 * Number(ratio(k)))}vw`} />
            </a>
          ))}
          {c.more && (
            <a class="g-more" href={ig.url} target="_blank" rel="noopener" data-reveal style="--r:1">
              <Logo />
              <span>{s.gallery.more}</span>
              <span class="link">@{ig.handle}</span>
            </a>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section-sm">
    <div class="wrap"><p class="section-foot" data-reveal style="margin-top:0"><a class="btn" href={ig.url} target="_blank" rel="noopener">{s.common.followInstagram}</a></p></div>
  </section>

  <dialog class="lb" aria-label={s.nav.gallery} data-lb>
    <button class="lb-close" type="button" data-lb-close aria-label={ui.close}>×</button>
    <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label={ui.prev}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
    </button>
    <figure class="lb-fig">
      <img alt="" data-lb-img />
      <figcaption><span data-lb-cap></span><a class="link" data-lb-post target="_blank" rel="noopener">{s.gallery.open}</a></figcaption>
    </figure>
    <button class="lb-nav lb-next" type="button" data-lb-next aria-label={ui.next}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
  </dialog>
</Base>

<script>
  // Visionneuse : clic sur une photo → grand format, flèches / clavier pour naviguer, Échap pour fermer.
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
  if (dlg && items.length) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const post = dlg.querySelector<HTMLAnchorElement>('[data-lb-post]')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const a = items[i];
      img.src = a.href;
      img.alt = a.dataset.caption ?? '';
      cap.textContent = a.dataset.caption ?? '';
      post.href = a.dataset.post ?? '#';
    };
    items.forEach((a, n) => a.addEventListener('click', (e) => {
      e.preventDefault();
      show(n);
      dlg.showModal();
      document.body.style.overflow = 'hidden';
    }));
    const close = () => { dlg.close(); };
    dlg.addEventListener('close', () => { document.body.style.overflow = ''; items[i]?.focus(); });
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
    });
    // Clic sur le fond : fermer
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  }
</script>
