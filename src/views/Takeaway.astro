---
// Afhaal : un nouveau menu à emporter chaque semaine (commande par téléphone jusqu'au jeudi,
// retrait le vendredi à l'atelier) + l'offre « Afhaal Feestdagen 2026 » (publication Instagram du 20/11/2026).
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Carousel from '../components/Carousel.astro';
import { feest, feestSlides, feestPost } from '../lib/feestdagen';
import { site, telHref } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const k = s.takeaway;
const ig = site.social.instagram;
const f = feest[lang];
---
<Base lang={lang} title={s.meta.takeawayTitle} description={s.meta.takeawayDesc} alternates={allLangs((l) => pagePath('takeaway', l))}
  section="takeaway" breadcrumbs={[{ name: s.nav.takeaway, path: pagePath('takeaway', lang) }]} ogPhoto="feest-cover">
  <section class="hero">
    <div class="wrap g12">
      <div class="hero-text">
        <p class="label rise" style="--d:.05s">{k.label}</p>
        <h1 style="font-size:clamp(2.8rem,1.5rem + 3.8vw,5.5rem);line-height:1">{k.title}</h1>
        <p class="lead rise" style="--d:.45s">{k.lead}</p>
        <p class="actions rise" style="--d:.6s">
          <a class="btn btn-solid" href={telHref}>{k.call} · {site.phone}</a>
          <a class="link" href={ig.url} target="_blank" rel="noopener">{k.follow}</a>
        </p>
      </div>
      <div class="hero-media"><Photo name="feest-cover" lang={lang} eager maxh="calc(100svh - var(--header-h) - 8rem)" sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <!-- 01 · Afhaal Feestdagen 2026 -->
  <section class="section bg-2" id="feestdagen">
    <div class="wrap">
      <div class="section-head">
        <div><p class="label" data-reveal><span class="n">01</span> {f.label}</p><h2>{f.title}</h2></div>
        <div class="head-side" data-reveal><p class="lead">{f.lead}</p><a class="link" href={feestPost} target="_blank" rel="noopener">{s.gallery.open}</a></div>
      </div>
      <div class="g12 feest-page">
        <div class="feest-carousel"><Carousel photos={feestSlides} lang={lang} label={f.label} height="min(56svh, 31rem)" /></div>
        <div class="feest-info">
          <div class="feest-block" data-reveal>
            <h3>{f.menuTitle}</h3>
            <dl class="feest-courses">{f.courses.map((c) => <div><dt>{c.name}</dt><dd>{c.dish}</dd></div>)}</dl>
            <ul class="feest-prices">{f.prices.map((p) => <li><span>{p.name}</span><span>{p.price}</span></li>)}</ul>
            <p class="feest-note">{f.fourNote}</p>
            <p class="feest-note">{f.allergens}</p>
          </div>
          <div class="feest-side">
            <div class="feest-block" data-reveal>
              <h3>{f.classicsTitle}</h3>
              <ul class="feest-prices">{f.classics.map((c) => <li><span>{c.name}{c.note && <small>{c.note}</small>}</span><span>{c.price}</span></li>)}</ul>
            </div>
            <div class="feest-block" data-reveal>
              <h3>{f.orderTitle}</h3>
              <ul class="feest-lines">{f.order.map((o) => <li>{o}</li>)}</ul>
              <p><a class="link" href={`mailto:${site.takeawayEmail}`}>{site.takeawayEmail}</a></p>
              <h3>{f.pickupTitle}</h3>
              <ul class="feest-lines">{f.pickup.map((o) => <li>{o}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="label" data-reveal><span class="n">02</span> {k.howLabel}</p><h2>{k.howTitle}</h2></div>
      </div>
      <!-- Schéma : la semaine du menu à emporter (nouveau menu → commande par téléphone jusqu'à jeudi → retrait vendredi) -->
      <div class="week" data-reveal>
        <div class="week-days" aria-hidden="true">{k.scheme.days.map((d, i) => <span class:list={{ 'is-fri': i === 4 }}>{d}</span>)}</div>
        <div class="week-bars">
          <p class="wk-menu"><span class="wk-pin" aria-hidden="true"></span>{k.scheme.menu}</p>
          <p class="wk-order"><strong>{k.scheme.order}</strong><a href={telHref}>{site.phone}</a></p>
          <p class="wk-pick"><strong>{k.scheme.pick}</strong><span>{k.scheme.where}</span></p>
        </div>
      </div>
      <p class="feest-note week-allergens" data-reveal>{f.allergens}</p>
      <ol class="week-steps">
        {k.how.map((p, i) => <li data-reveal style={`--d:${i * 0.1}s`}><span class="ws-n">{String(i + 1).padStart(2, '0')}</span><h3>{p.title}</h3><p>{p.text}</p></li>)}
      </ol>
    </div>
  </section>

</Base>
