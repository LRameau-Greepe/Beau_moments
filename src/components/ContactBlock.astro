---
// Adresse de l'atelier, téléphones (Aude, Bert), e-mail et Instagram.
import { site, tel, mailHref } from '../lib/site';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang; guests?: boolean }
const { lang, guests = false } = Astro.props;
const s = t(lang);
const ig = site.social.instagram;
---
<dl class="info" data-reveal>
  {guests && (
    <div class="info-row">
      <dt>{s.atelier.guests}</dt>
      <dd><p>{s.atelier.guestsText}</p></dd>
    </div>
  )}
  <div class="info-row">
    <dt>{s.atelier.address}</dt>
    <dd>
      <p>BEAU MOMENTS · {site.address.street}</p>
      <p>{site.address.postalCode} {site.address.city}</p>
      <p class="actions"><a class="link" href={site.mapUrl} target="_blank" rel="noopener">{s.common.openMap}</a></p>
    </dd>
  </div>
  <div class="info-row">
    <dt>{s.atelier.contact}</dt>
    <dd>
      <p class="muted">{s.atelier.contactText}</p>
      {site.contacts.map((c) => <p>{c.name} · <a href={tel(c.phone)}>{c.phone}</a></p>)}
      <p><a href={mailHref}>{site.email}</a></p>
      <p><a href={ig.url} target="_blank" rel="noopener">@{ig.handle}</a></p>
    </dd>
  </div>
</dl>
