---
// Logotype « BEAU MOMENTS » + « catering & private dining », comme sur la carte de visite.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['wordmark', cls]}>
  <span class="wm-name">Beau Moments</span>
  <span class="wm-sub">Catering &amp; private dining</span>
</span>
