---
// Carrousel de photos (même format pour toutes) : glisser, flèches, clavier, barre de progression.
// Utilisé pour l'offre « Afhaal Feestdagen » (accueil et page Afhaal).
import Photo from './Photo.astro';
import type { PhotoKey } from '../lib/photos';
import { L as Lx, type Lang } from '../i18n/locales';
interface Props {
  photos: PhotoKey[];
  lang: Lang;
  label: string;
  /** Format commun des cadres (largeur / hauteur) */
  frame?: [number, number];
  /** Hauteur des photos (CSS) */
  height?: string;
  sizes?: string;
}
const { photos, lang, label, frame = [3, 4], height = 'min(60svh, 34rem)', sizes = '(min-width: 860px) 30vw, 70vw' } = Astro.props;
const L = Lx(lang);
const style = `--frame:${frame[0]} / ${frame[1]};--fr:${(frame[0] / frame[1]).toFixed(4)};--ch:${height}`;
---
<div class="g-carousel c-carousel" data-ccarousel data-reveal style={style}>
  <div class="g-track" tabindex="0" role="region" aria-label={label}>
    {photos.map((k) => <div class="g-item g-frame"><Photo name={k} lang={lang} sizes={sizes} /></div>)}
  </div>
  <div class="rv-foot">
    <div class="rv-progress" aria-hidden="true"><span></span></div>
    <div class="rv-nav">
      <button class="rv-btn" type="button" data-prev aria-label={L('Vorige', 'Précédent', 'Previous')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      </button>
      <button class="rv-btn" type="button" data-next aria-label={L('Volgende', 'Suivant', 'Next')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ccarousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.g-track')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const bar = root.querySelector<HTMLElement>('.rv-progress span')!;
    const step = () => {
      const item = track.querySelector<HTMLElement>('.g-item');
      return item ? item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = track.clientWidth / track.scrollWidth;
      const pos = max > 0 ? track.scrollLeft / max : 0;
      bar.style.setProperty('--w', `${ratio * 100}%`);
      bar.style.setProperty('--x', `${pos * (1 / ratio - 1) * 100}%`);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); track.scrollBy({ left: step(), behavior: 'smooth' }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); track.scrollBy({ left: -step(), behavior: 'smooth' }); }
    });
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    let down = false, moved = false, startX = 0, startLeft = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) { moved = true; track.classList.add('is-dragging'); }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', () => { if (!down) return; down = false; track.classList.remove('is-dragging'); });
    track.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>
