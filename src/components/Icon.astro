---
// Petites icônes au trait.
interface Props { name: 'instagram' | 'star' | 'rings' | 'tower' | 'spark' | 'arrow'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'instagram' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" /></svg>
)}
{name === 'star' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c.6 6.6 5.4 11.4 12 12-6.6.6-11.4 5.4-12 12-.6-6.6-5.4-11.4-12-12C6.6 11.4 11.4 6.6 12 0Z" /></svg>
)}
{name === 'rings' && (
  <svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="18" cy="29" r="11" /><circle cx="30" cy="29" r="11" /><path d="M24 6l3 4-3 4-3-4z" /></svg>
)}
{name === 'tower' && (
  <svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8 10h12l-6 8zM28 10h12l-6 8zM18 26h12l-6 8z" /><path d="M14 18v4M34 18v4M24 34v8M18 42h12" /></svg>
)}
{name === 'spark' && (
  <svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M16 14h16l-2 22H18z" /><path d="M17 22h14" /><path d="M36 6v6M33 9h6M10 30v4M8 32h4M38 24l2 2" /></svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
)}
