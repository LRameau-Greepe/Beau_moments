---
// Deux dessins au trait détaillés, dans l'esprit du chariot TINI : les traits se dessinent
// quand le dessin entre à l'écran (pathLength = 1, voir .mbar dans global.css).
//  - « table » : la table dressée de BEAU MOMENTS (nappe drapée, cloche sur présentoir, candélabres,
//    verres, bouquets et suspensions en rotin comme dans l'atelier)
//  - « cloche » : cloche en argent gravée BA sur plat ovale, serviette pliée, brin d'herbes et flûte
interface Props { name: 'table' | 'cloche'; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;

// Table : festons de l'ourlet et plis de la nappe
const hemX = Array.from({ length: 9 }, (_, i) => 44 + i * 69);
const hem = `M44 326 ${hemX.slice(1).map((x) => `Q${x - 34.5} 340 ${x} 326`).join(' ')}`;
const folds = hemX.slice(1, -1).map((x, i) => `M${x} 270 Q${x + (i % 2 ? 3 : -3)} 298 ${x} 326`);
// Candélabre à trois branches centré en cx
const candelabra = (cx: number) => ({
  base: `M${cx - 18} 256 Q${cx} 262 ${cx + 18} 256 Q${cx} 250 ${cx - 18} 256 Z M${cx - 2} 254 V214 M${cx + 2} 254 V214`,
  arms: `M${cx} 214 Q${cx - 24} 214 ${cx - 26} 196 M${cx} 214 Q${cx + 24} 214 ${cx + 26} 196 M${cx - 2} 214 V190 M${cx + 2} 214 V190 M${cx - 32} 196 H${cx - 20} M${cx - 6} 190 H${cx + 6} M${cx + 20} 196 H${cx + 32}`,
  candles: `M${cx - 29} 196 V162 H${cx - 23} V196 M${cx - 3} 190 V148 H${cx + 3} V190 M${cx + 23} 196 V162 H${cx + 29} V196`,
  flames: [cx - 26, cx, cx + 26].map((x, i) => { const top = i === 1 ? 132 : 146; const b = i === 1 ? 145 : 159; return `M${x} ${b} Q${x + 4} ${b - 6} ${x} ${top} Q${x - 4} ${b - 6} ${x} ${b} Z`; }).join(' '),
});
const candelabras = [190, 450].map(candelabra);
// Suspension en rotin centrée en cx
const lamp = (cx: number) => ({
  cord: `M${cx} 0 V40`,
  globe: `M${cx} 40 A28 28 0 1 1 ${cx - 0.01} 40`,
  ribs: `M${cx - 28} 68 Q${cx} 78 ${cx + 28} 68 M${cx - 25} 55 Q${cx} 64 ${cx + 25} 55 M${cx - 25} 81 Q${cx} 91 ${cx + 25} 81 M${cx - 17} 45 Q${cx} 51 ${cx + 17} 45 M${cx - 17} 91 Q${cx} 98 ${cx + 17} 91 M${cx} 40 Q${cx + 13} 68 ${cx} 96 M${cx} 40 Q${cx - 13} 68 ${cx} 96`,
});
const lamps = [240, 400].map(lamp);
// Bouquet dans un petit vase centré en cx
const posy = (cx: number, flip: number) => ({
  vase: `M${cx - 8} 262 Q${cx - 12} 248 ${cx} 244 Q${cx + 12} 248 ${cx + 8} 262 Z`,
  stems: `M${cx} 244 Q${cx - 4 * flip} 226 ${cx - 12 * flip} 212 M${cx} 244 Q${cx + 2 * flip} 222 ${cx + 8 * flip} 204 M${cx} 244 Q${cx + 10 * flip} 232 ${cx + 20 * flip} 224 M${cx - 4 * flip} 228 Q${cx - 14 * flip} 226 ${cx - 18 * flip} 232`,
  blooms: [[cx - 12 * flip, 210, 5], [cx + 8 * flip, 201, 4.5], [cx + 21 * flip, 222, 4]] as [number, number, number][],
});
const posies = [posy(70, 1), posy(570, -1)];

// Cloche : perles de la frise, posées sur la courbe du bandeau
const beads = Array.from({ length: 13 }, (_, i) => {
  const x = 172 + i * 23;
  const y = 301 + 15 * (1 - ((x - 310) / 158) ** 2) + 5;
  return [x, Math.round(y * 10) / 10];
});
---
<svg class:list={['mbar', 'sketch', `sketch-${name}`, cls]} viewBox={name === 'table' ? '0 0 640 400' : '40 96 560 316'}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} data-reveal="draw">
  {name === 'table' && (
    <>
      <!-- Suspensions en rotin -->
      {lamps.map((l, i) => (
        <>
          <path class="d flute" style={`--k:${i * 0.3}`} pathLength="1" d={l.cord} />
          <path class="d" style={`--k:${0.4 + i * 0.3}`} pathLength="1" d={l.globe} />
          <path class="d flute" style={`--k:${1 + i * 0.3}`} pathLength="1" d={l.ribs} />
        </>
      ))}
      <!-- Plateau, nappe, ourlet festonné, plis, pieds -->
      <path class="d" style="--k:1.4" pathLength="1" d="M96 238 H544 L596 266 H44 Z" />
      <path class="d" style="--k:1.8" pathLength="1" d="M44 266 V326 M596 266 V326" />
      <path class="d" style="--k:2.1" pathLength="1" d={hem} />
      {folds.map((f, i) => <path class="d flute" style={`--k:${2.4 + i * 0.08}`} pathLength="1" d={f} />)}
      <path class="d" style="--k:2.8" pathLength="1" d="M74 336 V384 M86 336 V384 M68 386 H92 M554 336 V384 M566 336 V384 M548 386 H572" />
      <!-- Chemin de table qui retombe, avec frange -->
      <path class="d flute" style="--k:3" pathLength="1" d="M268 238 L254 266 M372 238 L386 266 M254 266 V298 H386 V266" />
      <path class="d flute" style="--k:3.2" pathLength="1" d={Array.from({ length: 15 }, (_, i) => `M${258 + i * 9} 298 V305`).join(' ')} />
      <!-- Présentoir et cloche gravée -->
      <path class="d" style="--k:3.4" pathLength="1" d="M292 254 Q320 260 348 254 Q320 248 292 254 Z M314 252 Q312 244 316 238 H324 Q328 244 326 252" />
      <path class="d" style="--k:3.6" pathLength="1" d="M254 236 Q320 246 386 236 Q320 226 254 236 Z" />
      <path class="d" style="--k:3.9" pathLength="1" d="M262 232 C262 182 292 160 320 160 C348 160 378 182 378 232" />
      <path class="d" style="--k:4.2" pathLength="1" d="M266 222 Q320 232 374 222 M314 160 Q314 152 320 150 Q326 152 326 160" />
      <circle class="d" style="--k:4.3" pathLength="1" cx="320" cy="144" r="6" />
      <path class="d flute" style="--k:4.5" pathLength="1" d="M282 216 Q280 190 300 174 M362 214 Q366 196 356 182" />
      <text class="mono" x="320" y="206" text-anchor="middle" font-size="19" font-family="'Cormorant Garamond', Georgia, serif" letter-spacing="1">BA</text>
      <!-- Candélabres -->
      {candelabras.map((c, i) => (
        <>
          <path class="d" style={`--k:${4.6 + i * 0.3}`} pathLength="1" d={c.base} />
          <path class="d" style={`--k:${5 + i * 0.3}`} pathLength="1" d={c.arms} />
          <path class="d" style={`--k:${5.4 + i * 0.3}`} pathLength="1" d={c.candles} />
          <path class="d" style={`--k:${5.9 + i * 0.3}`} pathLength="1" d={c.flames} />
        </>
      ))}
      <!-- Verres à vin -->
      {[122, 518].map((x, i) => (
        <path class="d" style={`--k:${6.4 + i * 0.2}`} pathLength="1"
          d={`M${x - 10} 214 Q${x - 11} 240 ${x} 242 Q${x + 11} 240 ${x + 10} 214 Z M${x - 9} 228 Q${x} 232 ${x + 9} 228 M${x} 242 V256 M${x - 10} 258 Q${x} 262 ${x + 10} 258`} />
      ))}
      <!-- Petits bouquets -->
      {posies.map((p, i) => (
        <>
          <path class="d" style={`--k:${6.8 + i * 0.2}`} pathLength="1" d={p.vase} />
          <path class="d" style={`--k:${7.1 + i * 0.2}`} pathLength="1" d={p.stems} />
          {p.blooms.map(([x, y, r], j) => <circle class="d" style={`--k:${7.4 + i * 0.2 + j * 0.1}`} pathLength="1" cx={x} cy={y} r={r} />)}
        </>
      ))}
    </>
  )}
  {name === 'cloche' && (
    <>
      <!-- Serviette pliée -->
      <path class="d" style="--k:0" pathLength="1" d="M60 368 L170 340 L200 382 L92 404 Z" />
      <path class="d flute" style="--k:0.4" pathLength="1" d="M120 354 L150 394 M68 372 L168 346" />
      <!-- Plat ovale -->
      <path class="d" style="--k:0.6" pathLength="1" d="M110 336 A200 36 0 1 0 510 336 A200 36 0 1 0 110 336 Z" />
      <path class="d flute" style="--k:1" pathLength="1" d="M134 336 A176 27 0 1 0 486 336 A176 27 0 1 0 134 336 Z" />
      <!-- Cloche : silhouette, bord, frise perlée -->
      <path class="d" style="--k:1.4" pathLength="1" d="M146 330 C146 214 228 158 310 158 C392 158 474 214 474 330" />
      <path class="d" style="--k:1.8" pathLength="1" d="M146 330 Q310 360 474 330" />
      <path class="d" style="--k:2.1" pathLength="1" d="M150 296 Q310 326 470 296 M152 308 Q310 338 468 308" />
      {beads.map(([x, y], i) => <circle class="d" style={`--k:${2.4 + i * 0.05}`} pathLength="1" cx={x} cy={y} r="2.2" />)}
      <!-- Prise -->
      <path class="d" style="--k:3" pathLength="1" d="M284 162 Q310 150 336 162 M302 156 Q300 142 310 138 Q320 142 318 156" />
      <circle class="d" style="--k:3.3" pathLength="1" cx="310" cy="126" r="12" />
      <circle class="d" style="--k:3.5" pathLength="1" cx="310" cy="110" r="4" />
      <!-- Reflets et ombres -->
      <path class="d" style="--k:3.7" pathLength="1" d="M196 290 Q190 232 248 186" />
      <path class="d flute" style="--k:3.9" pathLength="1" d="M214 284 Q210 240 252 206 M432 290 Q436 254 418 222 M446 290 Q450 250 432 214 M458 290 Q462 256 448 228" />
      <!-- Cartouche gravé -->
      <circle class="d flute" style="--k:4.1" pathLength="1" cx="310" cy="244" r="34" />
      <text class="mono" x="310" y="255" text-anchor="middle" font-size="30" font-family="'Cormorant Garamond', Georgia, serif" letter-spacing="2">BA</text>
      <!-- Brin d'herbes -->
      <path class="d" style="--k:4.4" pathLength="1" d="M424 354 Q456 352 488 336" />
      <path class="d" style="--k:4.6" pathLength="1" d="M440 352 Q446 340 458 344 Q452 354 440 352 Z M460 348 Q468 336 480 341 Q472 350 460 348 Z M452 352 Q458 362 470 360 Q462 350 452 352 Z" />
      <!-- Flûte de champagne -->
      <path class="d" style="--k:4.8" pathLength="1" d="M540 196 Q536 262 552 270 Q568 262 564 196 Z M538 214 H566" />
      <path class="d" style="--k:5.2" pathLength="1" d="M552 270 V376 M530 380 Q552 388 574 380" />
      <circle class="d flute" style="--k:5.4" pathLength="1" cx="552" cy="240" r="1.6" />
      <circle class="d flute" style="--k:5.5" pathLength="1" cx="548" cy="226" r="1.2" />
      <circle class="d flute" style="--k:5.6" pathLength="1" cx="557" cy="252" r="1.2" />
    </>
  )}
</svg>
