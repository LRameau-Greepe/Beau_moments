---
// Questions fréquentes (accordéon). Les données structurées FAQPage sont ajoutées par la page.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}<i aria-hidden="true"></i></summary>
      <div class="faq-a"><p>{it.a}</p></div>
    </details>
  ))}
</div>
