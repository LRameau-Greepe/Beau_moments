---
// Gabarit HTML commun (V2) : référencement, en-tête, menu plein écran, visionneuse photo, pied de page.
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { getImage } from 'astro:assets';
import { site, abs, tel, mailHref } from '../lib/site';
import { getPhoto, type PhotoKey } from '../lib/photos';
import { eventTypes } from '../lib/events';
import { company, legalNotice, privacyPolicy } from '../lib/legal';
import { langs, localeInfo, defaultLang, L as L3x, type Lang } from '../i18n/locales';
import { pagePath, eventPath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Adresse de cette page dans chaque langue (balises hreflang + sélecteur de langue) */
  alternates?: Record<Lang, string>;
  noindex?: boolean;
  /** Données structurées supplémentaires */
  extraLd?: Record<string, unknown>[];
  /** Photo du site utilisée comme image de partage */
  ogPhoto?: PhotoKey;
  /** Fil d'Ariane (l'accueil est ajouté automatiquement) */
  breadcrumbs?: { name: string; path: string }[];
  /** Masquer le bandeau « demande » en bas de page */
  hideCta?: boolean;
  /** Section active du menu */
  section?: 'catering' | 'atelier' | 'takeaway' | 'gallery' | 'about';
}
const { lang, title, description, alternates, noindex = false, extraLd = [], ogPhoto, breadcrumbs = [], hideCta = false, section } = Astro.props;
const s = t(lang);
const L = localeInfo[lang];
const ig = site.social.instagram;
const alts = alternates ?? allLangs((l) => pagePath('home', l));

// Titre : au-delà de ~62 caractères, Google le coupe ; on raccourcit la signature.
const pageTitle = title.length > 62 ? title.replace(/ — BEAU MOMENTS.*$/, ' | BEAU MOMENTS') : title;
// Image de partage 1200×630, recadrée sur le point d'intérêt de la photo
const sharePhoto = getPhoto(ogPhoto ?? 'table-room');
const shareImg = await getImage({ src: sharePhoto.src, width: 1200, height: 630, fit: 'cover', position: 'attention', format: 'jpg' });
const shareUrl = abs(shareImg.src);
// Description : Google en affiche ~160 caractères ; au-delà, on coupe proprement sur un mot.
const metaDesc = description.length > 160 ? description.slice(0, 158).replace(/[\s,;:—–-]+[^\s]*$/, '') + '…' : description;
const canonical = abs(Astro.url.pathname);
const crumbs = [{ name: s.nav.home, path: pagePath('home', lang) }, ...breadcrumbs];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FoodEstablishment',
      '@id': `${site.siteUrl}/#business`,
      name: site.name,
      alternateName: [site.fullName, 'Beau Moments catering', 'Beau Moments Maldegem'],
      description: s.meta.homeDesc,
      slogan: site.tagline,
      url: abs(pagePath('home', lang)),
      image: shareUrl,
      logo: abs('/assets/img/icon-512.png'),
      telephone: site.phone,
      email: site.email,
      servesCuisine: ['French', 'Belgian', 'Catering', 'Private dining'],
      acceptsReservations: true,
      founder: [{ '@type': 'Person', name: 'Bert', jobTitle: 'Chef' }, { '@type': 'Person', name: 'Aude' }],
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.country,
      },
      hasMap: site.mapUrl,
      areaServed: ['Maldegem', 'Meetjesland', 'Brugge', 'Gent', 'Oost-Vlaanderen', 'West-Vlaanderen'].map((name) => ({ '@type': 'Place', name })),
      sameAs: [ig.url],
      makesOffer: eventTypes.map((e) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: e.copy[lang].name, url: abs(eventPath(e.key, lang)) },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.siteUrl}/#site`,
      url: `${site.siteUrl}/`,
      name: site.name,
      alternateName: site.fullName,
      inLanguage: langs.map((l) => localeInfo[l].html),
      publisher: { '@id': `${site.siteUrl}/#business` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: pageTitle,
      description: metaDesc,
      inLanguage: L.html,
      isPartOf: { '@id': `${site.siteUrl}/#site` },
      about: { '@id': `${site.siteUrl}/#business` },
      primaryImageOfPage: { '@type': 'ImageObject', url: shareUrl },
      ...(crumbs.length > 1 ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(crumbs.length > 1
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })),
        }]
      : []),
    ...extraLd,
  ],
};

const L3 = L3x(lang);
const nav = [
  { key: 'about', href: pagePath('about', lang), label: s.nav.about },
  { key: 'catering', href: pagePath('catering', lang), label: s.nav.catering },
  { key: 'atelier', href: pagePath('atelier', lang), label: s.nav.atelier },
  { key: 'takeaway', href: pagePath('takeaway', lang), label: s.nav.takeaway },
  { key: 'gallery', href: pagePath('gallery', lang), label: s.nav.gallery },
];
const enquire = `${pagePath('catering', lang)}#aanvraag`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={L.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={abs(alts[l])} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(alts[defaultLang])} />}
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/img/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f0ea" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={L.og} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={localeInfo[l].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sharePhoto.alt[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="geo.region" content="BE-VOV" />
    <meta name="geo.placename" content="Maldegem" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{s.nav.skip}</a>
    <header class="top">
      <a class="brand" href={pagePath('home', lang)} aria-label={`BEAU MOMENTS — ${s.nav.home}`}>Beau Moments</a>
      <div class="top-right">
      <nav class="lang" aria-label={s.nav.language}>
        {langs.map((l) => <a href={alts[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={localeInfo[l].name}>{localeInfo[l].short}</a>)}
      </nav>
      <a class="btn top-cta second" href={pagePath('takeaway', lang)}>{s.nav.takeaway}</a>
      <a class="btn top-cta" href={enquire}>{s.nav.book}</a>
      </div>
      <button class="menu-btn" type="button" aria-haspopup="dialog" data-menu-open><i aria-hidden="true"></i><span>{s.nav.menu}</span></button>
    </header>

    <dialog class="menu" aria-label={s.nav.main} data-menu>
      <button class="menu-close" type="button" data-menu-close>{s.nav.close}</button>
      <nav aria-label={s.nav.main}>
        <ul role="list">
          {nav.map((l, i) => (
            <li style={`--i:${i}`}><a href={l.href} aria-current={section === l.key ? 'page' : undefined}>{l.label}</a>
              {l.key === 'catering' && <p class="sub">{eventTypes.map((e) => <a href={eventPath(e.key, lang)}>{e.copy[lang].name}</a>)}</p>}</li>
          ))}
        </ul>
      </nav>
      <p class="menu-foot"><a href={enquire}>{s.nav.book}</a><a href={`${pagePath('home', lang)}#contact`}>{s.footer.contact}</a><a href={tel(site.phone)}>{site.phone}</a><a href={ig.url} target="_blank" rel="noopener">@{ig.handle}</a></p>
    </dialog>
    <noscript><nav class="nojs">{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav></noscript>

    <main id="main"><slot /></main>

    {!hideCta && (
      <section class="cta pad stone"><div class="wrap"><h2>{s.catering.formTitle}</h2><a class="btn" href={enquire}>{s.nav.book}</a></div></section>
    )}

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-brand"><Logo title="BEAU MOMENTS" /></div>
        <ul role="list">{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        <ul role="list">{eventTypes.map((e) => <li><a href={eventPath(e.key, lang)}>{e.copy[lang].name}</a></li>)}</ul>
        <ul role="list">
          <li><a href={site.mapUrl} target="_blank" rel="noopener">{site.address.street}, {site.address.postalCode} {site.address.city}</a></li>
          {site.contacts.map((c) => <li><a href={tel(c.phone)}>{c.name} {c.phone}</a></li>)}
          <li><a href={mailHref}>{site.email}</a></li>
          <li><a href={ig.url} target="_blank" rel="noopener">@{ig.handle}</a></li>
        </ul>
      </div>
      <p class="wrap foot-legal"><span>© {year} BEAU MOMENTS VOF</span><span>{company.vat}</span><a href={pagePath('legal', lang)}>{legalNotice[lang].title}</a><a href={pagePath('privacy', lang)}>{privacyPolicy[lang].title}</a></p>
    </footer>

    <dialog class="lb" aria-label={s.nav.gallery} data-lb>
      <figure><img alt="" data-lb-img /><figcaption><span data-lb-cap></span><a data-lb-post target="_blank" rel="noopener">{s.gallery.open}</a></figcaption></figure>
      <button class="lb-x" type="button" data-lb-close aria-label={s.nav.close}>×</button>
      <button class="lb-p" type="button" data-lb-prev aria-label={L3('Vorige foto', 'Photo précédente', 'Previous photo')}>←</button>
      <button class="lb-n" type="button" data-lb-next aria-label={L3('Volgende foto', 'Photo suivante', 'Next photo')}>→</button>
    </dialog>

    <script>
      // ---- Menu plein écran ----
      const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
      document.querySelector('[data-menu-open]')!.addEventListener('click', () => menu.showModal());
      document.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));

      // ---- Visionneuse (galerie) ----
      const dlg = document.querySelector<HTMLDialogElement>('[data-lb]')!;
      const big = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
      const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
      const post = dlg.querySelector<HTMLAnchorElement>('[data-lb-post]')!;
      const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
      let cur = 0;
      const show = (n: number) => {
        cur = (n + items.length) % items.length;
        const a = items[cur];
        big.src = a.href;
        big.alt = cap.textContent = a.dataset.caption ?? '';
        post.href = a.dataset.post ?? '#';
      };
      items.forEach((a, n) => a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        show(n);
        dlg.showModal();
      }));
      const close = () => dlg.close();
      dlg.addEventListener('close', () => items[cur]?.focus({ preventScroll: true }));
      dlg.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('img, button, a')) close(); });
      dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
      dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(cur - 1));
      dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(cur + 1));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(cur + 1);
        if (e.key === 'ArrowLeft') show(cur - 1);
      });
    </script>
  </body>
</html>
